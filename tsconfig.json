{
  "extends": "../dsh/tsconfig.base.client.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "composite": false,
    "incremental": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "sourceMap": false,
    "exactOptionalPropertyTypes": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "typeRoots": [
      "./node_modules/@types",
      "../dsh/scripts/types",
      "../dsh/node_modules/@types"
    ],
    "types": ["node"]
  },
  "include": ["src"]
}
